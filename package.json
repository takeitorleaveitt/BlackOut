{
  "name": "blackout-protocol",
  "version": "1.0.0",
  "description": "BLACKOUT PROTOCOL - a browser-based tactical first-person shooter with bodycam presentation and authoritative multiplayer.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n CLIENT,SERVER -c cyan,magenta \"vite\" \"node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build && npm run check:privacy",
    "check:privacy": "node scripts/check-privacy.mjs",
    "preview": "vite preview",
    "start": "npm run build && node server/index.js",
    "serve": "node server/index.js",
    "bundle:server": "npx --yes esbuild@0.24 server/index.js --bundle --platform=node --format=cjs --outfile=pkg-build/server.cjs --log-level=warning",
    "package:desktop": "npm run build && npm run bundle:server && npx --yes @yao-pkg/pkg@5 -c pkg.config.json pkg-build/server.cjs --targets node20-win-x64,node20-linux-x64 --out-path pkg-dist"
  },
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
